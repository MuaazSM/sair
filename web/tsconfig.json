{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true, "isolatedModules": true,
    "allowImportingTsExtensions": true, "noEmit": true, "types": ["node"], "resolveJsonModule": true
  },
  "include": ["src", "tests", "*.ts"]
}
