#!/usr/bin/env bash
# Push only as MuaazSM, and only commits whose messages pass the commit-msg rules.
set -euo pipefail

login="$(gh api user -q .login 2>/dev/null || true)"
if [ "$login" != "MuaazSM" ]; then
  echo "pre-push: authenticated GitHub account is '${login:-none}', must be 'MuaazSM'." >&2
  exit 1
fi

zero="0000000000000000000000000000000000000000"
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    shas="$(git rev-list "$local_sha" --not --remotes)"
  else
    shas="$(git rev-list "$remote_sha..$local_sha")"
  fi
  hook_dir="$(cd "$(dirname "$0")" && pwd)"
  tmp="$(mktemp)"
  for sha in $shas; do
    git log -1 --format=%B "$sha" > "$tmp"
    if ! "$hook_dir/commit-msg" "$tmp" 2>/dev/null; then
      echo "pre-push: commit ${sha:0:9} fails the commit-msg rules." >&2
      rm -f "$tmp"
      exit 1
    fi
  done
  rm -f "$tmp"
done
