# Sair hub runtime (.env), prod. See IMPLEMENTATION.md §0.4. Never commit real values.
# No Tinker/HF/Sentry secrets here (least privilege; NFR-P7).
SAIR_ENV=prod
SAIR_HOST=127.0.0.1              # settings refuse anything non-loopback (NFR-P2)
SAIR_PORT=8787
SAIR_DATA_DIR=~/.sair            # run: tmutil addexclusion ~/.sair
SAIR_DB_PATH=~/.sair/sair.db
SAIR_TMP_DIR=~/.sair/tmp
SAIR_TZ=Asia/Kolkata
SAIR_TOKEN_MOM=
SAIR_TOKEN_DAD=
SAIR_TOKEN_OWNER=
SAIR_DEVICE_GROUPS=mom:Mom and Dad,dad:Mom and Dad   # set from OPEN-3 (PRD §3)

AUDIO_MIN_S=1
AUDIO_MAX_S=90
VAD_ENERGY_THRESHOLD=            # tuned in P0
TRANSCRIBE_CHUNK_S=0             # >0 only if Gemma is clip-limited (PRD §18.1)
TRANSIENT_RETRY_WINDOW_S=600

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_DEBUG=0
TRANSCRIBER=gemma                # gemma | whisper
WHISPER_MODEL_PATH=

WRITER_BACKEND=gemma             # gemma until G-ship passes, then llama (PRD §12.5)
WRITER_URL=http://127.0.0.1:8091
WRITER_MODEL_PATH=models/sair-writer-q4_k_m.gguf
WRITER_GRAMMAR=grammars/entry.gbnf
WRITER_JSON_SCHEMA=schemas/entry.schema.json
WRITER_MAX_TOKENS=400

TTS_ENGINE=kokoro                # kokoro | piper
KOKORO_MODEL_DIR=models/kokoro
KOKORO_VOICE=                    # chosen by Mom and Dad in P0
KOKORO_LANG=                     # OPEN-4
PIPER_VOICE_PATH=

MISSION_PREGEN_TIME=16:30
MISSION_PREGEN_BLOCK=11:30-16:00

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

NTFY_URL=http://127.0.0.1:8090   # self-hosted on the hub; phones subscribe via tailnet
NTFY_TOPIC=
NTFY_IOS_UPSTREAM=off            # NFR-P3: off by default; disclose in the post if on

SENTRY_DSN=                      # must stay EMPTY in prod (NFR-P7)
ALLOWED_OUTBOUND_HOSTS=127.0.0.1,localhost
