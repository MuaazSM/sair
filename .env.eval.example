# Dev/eval overrides (.env.eval). Synthetic and fixture data only. Sentry allowed here (NFR-P7).
# With a SENTRY_DSN set, settings refuse any data path inside the prod dir ~/.sair, so eval
# state lives in ~/.sair-eval. Family tokens are left empty (an empty value does not override .env).
SAIR_ENV=eval
SAIR_DATA_DIR=~/.sair-eval
SAIR_DB_PATH=~/.sair-eval/eval.db
SAIR_TMP_DIR=~/.sair-eval/tmp
SAIR_TOKEN_MOM=
SAIR_TOKEN_DAD=
SENTRY_DSN=
SENTRY_ENVIRONMENT=eval
SENTRY_TRACES_SAMPLE_RATE=1.0
ALLOWED_OUTBOUND_HOSTS=127.0.0.1,localhost,*.sentry.io   # wildcard covers regional ingest hosts (e.g. o123.ingest.us.sentry.io)
CANARY_MARKER=zebra-ultramarine-4471
