# Dev/eval overrides (.env.eval). Synthetic and fixture data only. Sentry allowed here (NFR-P7).
SAIR_ENV=eval
SAIR_DB_PATH=~/.sair/eval.db
SENTRY_DSN=
SENTRY_ENVIRONMENT=eval
SENTRY_TRACES_SAMPLE_RATE=1.0
ALLOWED_OUTBOUND_HOSTS=127.0.0.1,localhost,*.sentry.io   # wildcard covers regional ingest hosts (e.g. o123.ingest.us.sentry.io)
CANARY_MARKER=zebra-ultramarine-4471
